# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Safe defaults are provided for local development with Ollama and SQLite/PostgreSQL.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
APP_NAME="The Lenny Growth Assistant"

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# Active LLM Provider: 'ollama' (default/mandatory for local demo), 'anthropic', or 'openai'
LLM_PROVIDER=ollama

# Local LLM - Ollama Settings
# Ollama base API URL (use http://host.docker.internal:11434 if running backend inside Docker)
OLLAMA_BASE_URL=http://localhost:11434
# Local model to use (recommended for developer laptops: llama3.2, mistral, llama3, qwen2.5)
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=60.0

# Cloud LLM - Anthropic Claude (Optional / Alternative)
# Set LLM_PROVIDER=anthropic to activate
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Cloud LLM - OpenAI (Optional / Alternative)
# Set LLM_PROVIDER=openai to activate
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Model Fallback Behavior
# If true, the system gracefully falls back to mock/offline generation if configured provider is unreachable
ALLOW_MOCK_FALLBACK=true

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Primary: PostgreSQL Connection URL
# For Docker Compose: postgresql+asyncpg://postgres:postgres@db:5432/lenny_assistant
# For Local Host PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_assistant
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_assistant

# Dual Storage Strategy:
# If PostgreSQL is not reachable during local standalone testing, automatically fall back to SQLite
ENABLE_SQLITE_FALLBACK=true
SQLITE_DATABASE_URL=sqlite+aiosqlite:///./data/lenny_assistant.db

# ------------------------------------------------------------------------------
# Knowledge Base & Retrieval
# ------------------------------------------------------------------------------
DATA_DIR=./data
FIXTURES_DIR=./data/fixtures
SIMILARITY_THRESHOLD=0.45
TOP_K_CHUNKS=4
MAX_CONTEXT_TOKENS=3500

# ------------------------------------------------------------------------------
# Security & CORS
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
SECRET_KEY=lenny-growth-assistant-dev-insecure-secret-key-change-in-prod
